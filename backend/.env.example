# Model paths (weights located in project root)
FRESHNESS_MODEL_PATH=../rexnet150_freshness_best.pth
MARBLING_MODEL_PATH=../rexnet150_marbling_best.pth

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# Optional: Supabase configuration (leave empty or as-is for local SQLite mode)
# If left as placeholder or empty, the app runs completely offline using local SQLite & static storage.
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_SERVICE_KEY=placeholder-service-key
